# Exemplo de perfil local — copie para `application-local.yml` (não versionado)
# e substitua o secret abaixo por um valor seu (ex.: string base64 de 32+ bytes).
#   cp application-local.yml.example application-local.yml
# Para rodar: SPRING_PROFILES_ACTIVE=local ./mvnw spring-boot:run
spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/queueflow
    username: queueflow
    password: queueflow
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
  flyway:
    enabled: true

server:
  port: 8080

app:
  jwt:
    # Substitua por um secret próprio (base64 de 32 chars, por exemplo).
    secret: TROQUE-ME-por-um-secret-base64-de-32-chars
    expiration-ms: 86400000
  auth:
    cookie-secure: false
    cookie-same-site: Lax
  cors:
    allowed-origins: http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
