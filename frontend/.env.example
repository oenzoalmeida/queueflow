# Leave unset for local dev (uses the Vite proxy to http://localhost:8080).
# In production (Netlify), set this to the deployed backend's origin, e.g.:
# VITE_API_URL=https://queueflow-backend.onrender.com
VITE_API_URL=

# Optional: only needed if the WebSocket endpoint lives on a different host
# than VITE_API_URL. Usually left empty — it's derived from VITE_API_URL.
VITE_WS_URL=
